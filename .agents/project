#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in setup|resume|sync) ;; *) echo 'Usage: .agents/project setup|resume|sync' >&2; exit 2 ;; esac
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# No project-specific runtime overrides. The shared baseline owns agent tooling.

case "$1" in
	setup)
		node -e 'if (Number(process.versions.node.split(".")[0]) < 24) { console.error("Lookup requires Node.js 24 or newer"); process.exit(1); }'
		npm ci
		# Local-only and idempotent: never migrate the hosted database from setup.
		npm run db:init
		;;
	resume)
		# Dependencies and local database state persist; no wake-time installation.
		;;
	sync)
		# Runtime only: no app installation, migrations, seeds or services.
		;;
esac
